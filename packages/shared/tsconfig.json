{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ES2023",
		"strict": true,
		"declaration": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": [],
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src"]
}
